"""Paper-compatible K-input maximum using partition/0-coded vectors.

Compile-time arguments:
    L K N PRIME

Each input owner locally encodes its value and provides 2*L field elements:
the L-entry partition vector followed by the L-entry 0-coded vector. Inputs
are assigned round-robin, so input i belongs to party (i mod N).
"""

import operator

from Compiler import util


L = int(program.args[1])
K = int(program.args[2])
N = int(program.args[3])
PRIME = int(program.args[4])

if K < 2:
    raise ValueError("max requires at least two inputs")
if N < 2:
    raise ValueError("max requires at least two parties")
if PRIME.bit_length() != L:
    raise ValueError("L must equal ceil(log2(PRIME))")


def secure_comparison_gate(left, right):
    """Return encoded max(left, right), following Sections 3.3-3.4."""
    left_partition, left_zero = left
    right_partition, right_zero = right

    differences = left_partition - right_zero
    product = util.tree_reduce(
        operator.mul, [differences[i] for i in range(L)]
    )

    # g=0 iff left > right; g=1 iff left <= right.
    g = product ** (PRIME - 1)

    # a + g*(b-a) uses one secure multiplication per vector entry.
    out_partition = left_partition + g * (right_partition - left_partition)
    out_zero = left_zero + g * (right_zero - left_zero)
    return out_partition, out_zero


states = []
for input_index in range(K):
    owner = input_index % N
    partition = sint.get_input_from(owner, size=L)
    zero_coded = sint.get_input_from(owner, size=L)
    states.append((partition, zero_coded))

# Balanced SCG tree. An unpaired state is carried to the next level.
while len(states) > 1:
    next_level = []
    for i in range(0, len(states) - 1, 2):
        next_level.append(secure_comparison_gate(states[i], states[i + 1]))
    if len(states) % 2:
        next_level.append(states[-1])
    states = next_level

# The last partition entry is the original integer.
maximum = states[0][0][L - 1]
print_ln("MAX_RESULT %s", maximum.reveal())
